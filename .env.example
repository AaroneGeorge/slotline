# Copy to .env.local (never commit). All PayPal values are SANDBOX credentials.
PAYPAL_MODE=mock                 # mock | sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=               # id of the webhook you created in the developer dashboard for APP_BASE_URL/api/paypal/webhook
NEXT_PUBLIC_PAYPAL_CLIENT_ID=    # same as PAYPAL_CLIENT_ID, exposed to the booking page for the JS SDK
NEXT_PUBLIC_PAYPAL_CURRENCY=USD

LLM_PROVIDER=rules               # anthropic | gemini | groq | rules   (rules = deterministic planner, no key needed)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Operator sign-in for the dashboard and every operator API route (cookie session).
# REQUIRED in production (NODE_ENV=production: `next start`, Docker). Empty in development = operator routes OPEN
# (a loud warning is printed at startup). Use a long random value, e.g. `openssl rand -base64 24`.
OPERATOR_PASSWORD=
# SESSION_SECRET=                # optional: signs the session cookie (>= 32 chars); default: derived from OPERATOR_PASSWORD

DEV_TOOLS_SECRET=change-me       # x-dev-secret header for /api/dev/* and grant-less money actions; `off` disables dev tools.
                                 # Production refuses to start with this example value, unset, or < 16 chars (use `off` or `openssl rand -hex 24`).
APP_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/slotline.db
OPERATOR_TZ=America/Los_Angeles  # Dana's local time zone for working hours

# Optional (Stream A additions; defaults shown)
# AUTO_RESEED=daily              # daily | empty | off   reload Dana's demo day when the operator day changes / only on an empty DB / never
# PLANNER_TIMEOUT_MS=20000       # LLM planner timeout before falling back to rules
# MOCK_WEBHOOK_DELAY_MS=1500     # mock mode: delay of the simulated PayPal webhook after each API call (0 = off)
# MOCK_WEBHOOK_SECRET=           # mock mode: HMAC key for simulated webhook signatures. Development has a public built-in default;
                                 # production with PAYPAL_MODE=mock refuses to start without one (`openssl rand -hex 32`)
# SANDBOX_BUYER_EMAIL=           # scripts/sandbox-smoke.ts: invoice recipient (your sandbox personal account)
