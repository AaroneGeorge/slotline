{
  "id": "{{eventId}}",
  "event_version": "1.0",
  "create_time": "{{now}}",
  "resource_type": "refund",
  "resource_version": "2.0",
  "event_type": "PAYMENT.CAPTURE.REFUNDED",
  "summary": "A {{amount}} {{currency}} capture payment was refunded",
  "resource": {
    "id": "{{refundId}}",
    "status": "COMPLETED",
    "amount": { "currency_code": "{{currency}}", "value": "{{amount}}" },
    "note_to_payer": "Refund from Slotline",
    "custom_id": "{{bookingId}}",
    "invoice_id": "{{invoiceRef}}",
    "seller_payable_breakdown": {
      "gross_amount": { "currency_code": "{{currency}}", "value": "{{amount}}" },
      "net_amount": { "currency_code": "{{currency}}", "value": "{{amount}}" }
    },
    "create_time": "{{now}}",
    "update_time": "{{now}}",
    "links": [
      { "href": "https://api-m.sandbox.paypal.com/v2/payments/refunds/{{refundId}}", "rel": "self", "method": "GET" },
      { "href": "https://api-m.sandbox.paypal.com/v2/payments/captures/{{captureId}}", "rel": "up", "method": "GET" }
    ]
  },
  "links": [
    { "href": "https://api-m.sandbox.paypal.com/v1/notifications/webhooks-events/{{eventId}}", "rel": "self", "method": "GET" },
    { "href": "https://api-m.sandbox.paypal.com/v1/notifications/webhooks-events/{{eventId}}/resend", "rel": "resend", "method": "POST" }
  ]
}
