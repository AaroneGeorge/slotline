{
  "id": "{{eventId}}",
  "event_version": "1.0",
  "create_time": "{{now}}",
  "resource_type": "authorization",
  "resource_version": "2.0",
  "event_type": "PAYMENT.AUTHORIZATION.VOIDED",
  "summary": "A payment authorization was voided",
  "resource": {
    "id": "{{authorizationId}}",
    "status": "VOIDED",
    "amount": { "currency_code": "{{currency}}", "value": "{{amount}}" },
    "custom_id": "{{bookingId}}",
    "invoice_id": "{{invoiceRef}}",
    "supplementary_data": { "related_ids": { "order_id": "{{orderId}}" } },
    "create_time": "{{now}}",
    "update_time": "{{now}}",
    "links": [
      { "href": "https://api-m.sandbox.paypal.com/v2/payments/authorizations/{{authorizationId}}", "rel": "self", "method": "GET" }
    ]
  },
  "links": [
    { "href": "https://api-m.sandbox.paypal.com/v1/notifications/webhooks-events/{{eventId}}", "rel": "self", "method": "GET" },
    { "href": "https://api-m.sandbox.paypal.com/v1/notifications/webhooks-events/{{eventId}}/resend", "rel": "resend", "method": "POST" }
  ]
}
