{
  "id": "{{eventId}}",
  "event_version": "1.0",
  "create_time": "{{now}}",
  "resource_type": "dispute",
  "event_type": "CUSTOMER.DISPUTE.CREATED",
  "summary": "A new dispute opened with Case # {{disputeId}}",
  "resource": {
    "dispute_id": "{{disputeId}}",
    "create_time": "{{now}}",
    "update_time": "{{now}}",
    "disputed_transactions": [
      {
        "seller_transaction_id": "{{captureId}}",
        "custom": "{{bookingId}}",
        "invoice_number": "{{invoiceRef}}",
        "create_time": "{{now}}",
        "transaction_status": "COMPLETED",
        "gross_amount": { "currency_code": "{{currency}}", "value": "{{amount}}" },
        "buyer": { "name": "{{customerName}}" },
        "seller": { "name": "Slotline" }
      }
    ],
    "reason": "MERCHANDISE_OR_SERVICE_NOT_RECEIVED",
    "status": "OPEN",
    "dispute_amount": { "currency_code": "{{currency}}", "value": "{{amount}}" },
    "dispute_life_cycle_stage": "INQUIRY",
    "dispute_channel": "INTERNAL",
    "seller_response_due_date": "{{dueDate}}",
    "messages": [
      { "posted_by": "BUYER", "time_posted": "{{now}}", "content": "The technician never arrived for my repair." }
    ],
    "links": [
      { "href": "https://api-m.sandbox.paypal.com/v1/customer/disputes/{{disputeId}}", "rel": "self", "method": "GET" }
    ]
  },
  "links": [
    { "href": "https://api-m.sandbox.paypal.com/v1/notifications/webhooks-events/{{eventId}}", "rel": "self", "method": "GET" },
    { "href": "https://api-m.sandbox.paypal.com/v1/notifications/webhooks-events/{{eventId}}/resend", "rel": "resend", "method": "POST" }
  ]
}
